{
  "name": "brickwire",
  "version": "3.1.0",
  "private": true,
  "description": "Brickwire — turn web AI chats (ChatGPT, DeepSeek, Claude, Gemini, Qwen, Kimi, GLM, Arena) into a Roblox Studio agent via a browser extension, a local bridge and the built-in Roblox Studio MCP server.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node --import tsx scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 \"tests/unit/*.test.ts\" \"tests/integration/*.test.ts\"",
    "test:notion-shape": "node tests/browser/notion-shape.mjs",
    "test:chat": "node tests/browser/chat-qa.mjs",
    "test:e2e": "node --import tsx --test --test-concurrency=1 \"tests/e2e/*.test.ts\"",
    "test:all": "npm run typecheck && npm run build && npm test && npm run test:e2e",
    "start": "node bridge/dist/bridge.mjs",
    "dev:bridge": "node --import tsx bridge/src/index.ts",
    "studio:e2e": "node scripts/studio-e2e.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.50.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
