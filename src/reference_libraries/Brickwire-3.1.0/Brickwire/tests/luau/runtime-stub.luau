-- Runtime extras so scripts GENERATED by the BW helpers can be executed once in the stub (TEST ONLY).
-- Appended right after roblox-stub.luau (same chunk, so its locals are visible).
__WAITS = 0
__PLAYED = {}
local v3mt = getmetatable(Vector3.new(0, 0, 0))
v3mt.__add = function(a, b) return Vector3.new(a.X + b.X, a.Y + b.Y, a.Z + b.Z) end
v3mt.__sub = function(a, b) return Vector3.new(a.X - b.X, a.Y - b.Y, a.Z - b.Z) end
v3mt.__mul = function(a, b)
	if type(a) == "number" then a, b = b, a end
	if type(b) == "number" then return Vector3.new(a.X * b, a.Y * b, a.Z * b) end
	return Vector3.new(a.X * b.X, a.Y * b.Y, a.Z * b.Z)
end
function cfMt.Inverse(self) return CFrame.new(-self.Position.X, -self.Position.Y, -self.Position.Z) end
function cfMt.ToObjectSpace(a, b) return a:Inverse() * b end
function cfMt.VectorToWorldSpace(_, v) assert(rt(v) == "Vector3", "VectorToWorldSpace expects Vector3") return v end
local function signal(fire)
	return {
		Connect = function(_, fn) if fire then fn(fire()) end return { Disconnect = function() end } end,
		Wait = function() return true end,
	}
end
task = {
	wait = function() __WAITS += 1 if __WAITS > 6 then error("__STOP_LOOP", 0) end return 0 end,
	delay = function(_, fn, ...) fn(...) end,
	spawn = function(fn, ...) fn(...) end,
}
TweenInfo = { new = function(...) return { ... } end }
local runService = { Heartbeat = { Connect = function(_, fn) for _ = 1, 3 do fn(1 / 60) end return { Disconnect = function() end } end } }
local origGS = Methods.GetService
Methods.GetService = function(self, n)
	if n == "RunService" then return runService end
	if n == "KeyframeSequenceProvider" then
		return { RegisterKeyframeSequence = function(_, kfs) assert(kfs.ClassName == "KeyframeSequence", "KeyframeSequence expected") return "rbxassetid://9990001" end }
	end
	if n == "TweenService" then
		return { Create = function(_, inst, info, goal) assert(rt(inst) == "Instance" and type(goal) == "table", "TweenService:Create args") for k, v in pairs(goal) do assert(rt(v) == rt(inst[k]), "tween type " .. k) end return { Play = function() end } end }
	end
	if n == "Players" then
		local p = origGS(self, n)
		p.PlayerAdded = signal()
		return p
	end
	return origGS(self, n)
end
function Methods.LoadAnimation(self, anim)
	assert(self.ClassName == "Animator", "LoadAnimation must be called on an Animator, got " .. self.ClassName)
	assert(anim.ClassName == "Animation", "LoadAnimation expects an Animation")
	assert(string.match(anim.AnimationId, "^rbxassetid://%d+$"), "bad AnimationId " .. tostring(anim.AnimationId))
	table.insert(__PLAYED, anim.AnimationId)
	return { Looped = false, Play = function() end, Stop = function() end, AdjustSpeed = function() end }
end
function Methods.MoveTo(self, pos)
	assert(self.ClassName == "Humanoid", "MoveTo on " .. self.ClassName)
	assert(rt(pos) == "Vector3", "MoveTo expects Vector3, got " .. rt(pos))
end
function Methods.WaitForChild(self, n) return self:FindFirstChild(n) end
DEFAULTS.Animation = function() return { AnimationId = "" } end
DEFAULTS.Humanoid = function() return { WalkSpeed = 16, DisplayName = "", MoveToFinished = signal(), Died = signal() } end
DEFAULTS.ProximityPrompt = function() return { ActionText = "", ObjectText = "", HoldDuration = 0.5, MaxActivationDistance = 10, Triggered = signal(function() return nil end) } end
DEFAULTS.Tool = function() return { Equipped = signal(function() return nil end), Unequipped = signal(), Activated = signal(function() return nil end) } end
local partDefaults = DEFAULTS.Part
for cls, f in pairs(DEFAULTS) do
	if f == partDefaults then
		DEFAULTS[cls] = function() local p = partDefaults() p.CFrame = CFrame.new(p.Position) return p end
	end
end
-- require(ModuleScript) → runs its Source (fresh each time, like a clone) in this environment
local nativeRequire = require
require = function(m)
	if type(m) == "table" and rt(m) == "Instance" then
		assert(m.ClassName == "ModuleScript", "require expects a ModuleScript, got " .. m.ClassName)
		local fn, err = loadstring(rawget(m, "__props").Source or "", "=" .. m.Name)
		assert(fn, err)
		setfenv(fn, getfenv())
		return fn()
	end
	return nativeRequire(m)
end
