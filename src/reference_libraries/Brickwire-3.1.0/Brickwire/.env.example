# Brickwire bridge configuration (copy to .env). All values optional.

# Local port for the bridge HTTP API + dashboard (http://127.0.0.1:PORT)
BRICKWIRE_PORT=47821

# Studio MCP launcher. "auto" = official launcher:
#   Windows: cmd.exe /c %LOCALAPPDATA%\Roblox\mcp.bat
#   macOS:   /Applications/RobloxStudio.app/Contents/MacOS/StudioMCP
# "none" disables MCP. Otherwise give a command + JSON array of args.
BRICKWIRE_MCP_COMMAND=auto
# BRICKWIRE_MCP_ARGS=["/c","%LOCALAPPDATA%\\Roblox\\mcp.bat"]

# Optional: StudioMCP.exe (or its version-… folder) to use instead of auto-detection.
# Survives Studio updates: if Studio is running from a different version folder, the StudioMCP.exe
# next to the running Studio is used instead (an old proxy is rejected with "Client proxy is out of date").
# BRICKWIRE_STUDIO_MCP_PATH=C:\Users\you\AppData\Local\Roblox\Versions\version-xxxxxxxxxxxxxxxx

# Safety mode: auto (confirm destructive) | approval (confirm every change) | safe (read-only)
BRICKWIRE_MODE=auto

# MCP tools the AI may never call (comma separated). store_image reads local files.
BRICKWIRE_BLOCKED_TOOLS=store_image

# Where logs, project memory, sessions and settings are stored (relative to this folder)
BRICKWIRE_DATA_DIR=data

# debug | info | warn | error
BRICKWIRE_LOG_LEVEL=info

# Set to 1 if your Studio build's execute_luau does not return values (results are then printed + read from output)
BRICKWIRE_LUAU_PRINT_RESULTS=0

# Brickwire Pro: library update manifest (https)
# BRICKWIRE_UPDATE_URL=https://your-cdn.example/brickwire/manifest.json
# BRICKWIRE_LICENSE=

# Brickwire 3.0: files for the AI (file_fetch / file_save / file_show / file_upload_roblox / file_to_studio)
# Max size of one downloaded/created file in MB (default 50). Files are stored in <data dir>/ai-files.
# BRICKWIRE_FILES_MAX_MB=50
# Allow downloads from localhost / your LAN (blocked by default so the AI cannot reach your network or the bridge).
# BRICKWIRE_FILES_ALLOW_PRIVATE=0
# Upload to Roblox (images → Decal, sounds → Audio, fbx/glb/rbxm → Model, mp4 → Video). Key scopes: asset:read + asset:write
# ROBLOX_OPEN_CLOUD_API_KEY=
# ROBLOX_CREATOR_USER_ID=
# ROBLOX_CREATOR_GROUP_ID=

# Brickwire 3.1: Blender & Figma (app → «Blender и Figma»)
# Figma personal access token (Figma → Settings → Security → Personal access tokens, scope file_content:read).
# Can also be saved in the app; not needed when you use the Brickwire Figma plugin.
# FIGMA_TOKEN=
# Full path to Blender if the app does not find it (for «Запустить Blender»), e.g. C:\Program Files\Blender Foundation\Blender 4.2\blender.exe
# BRICKWIRE_BLENDER_EXE=
# Blender user config folder (default: %APPDATA%\Blender Foundation\Blender, ~/Library/Application Support/Blender, ~/.config/blender)
# BRICKWIRE_BLENDER_CONFIG_DIR=
